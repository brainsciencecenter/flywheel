#!/bin/bash

CmdName=$(basename "$0")
Syntax="${CmdName} [-f][-n][-t TmpDir][-v] Group/Project"

function sys {
    [ -n "${opt_n}${opt_v}" ] && echo "$@" 1>&2
    [ -n "${opt_n}" ] || "$@"
}

while getopts fnt:v arg
do
    case "$arg" in
	f|n|t|v)
	    eval "opt_${arg}='${OPTARG:=1}'"
	    ;;
    esac
done

shift $(( "$OPTIND" - 1 ))

TmpDir=/tmp
[ -n "$opt_t" ] && TmpDir="$opt_t"
if [ ! -e "$TmpDir" ]
then
     echo "${CmdName} : '${TmpDir}' does not exist.  Exiting" 1>&2
     exit 1
fi

ViewLabelsJsonFile="${TmpDir}/ViewLabels.json"

Group=$(echo "$1" | cut -f 1 -d /)
Project=$(echo "$1" | cut -f 2 -d /)

if [ -n "$opt_f" ] || [ ! -e "$ViewLabelsJsonFile" ]
then
    sys fwview -F json -c acquisition -p "${Group}/${Project}" project.group.label project.group._id project.label project.id subject.label subject.id session.label session.id acquisition.label acquisition.id | jq . > "$ViewLabelsJsonFile"
fi

Jq='
     [
       .data.[] as $x
           | {
                   ($x["project.group._id"]): $x["project.group.label"]
		 , ($x["project.id"]): $x["project.label"]
		 , ($x["subject.id"]): $x["subject.label"]
		 , ($x["session.id"]): $x["session.label"]
		 , ($x["acquisition.id"]): $x["acquisition.label"] 
	     }
     ] | add
' 
sys jq "$Jq" "$ViewLabelsJsonFile"
